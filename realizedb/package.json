{
  "name": "realizedb",
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma Imobiliária RealizeDB - Integrada com Centronic",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "client:dev": "vite --port 3002 --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && npm run server",
    "create-images": "node scripts/create-images-direct.js",
    "download-images": "bash download-real-images.sh",
    "upload-images": "node scripts/upload-real-images.js",
    "setup-images": "npm run download-images && npm run upload-images"  
  },
  "dependencies": {
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.6.0",
    "socket.io-client": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0",
    "vite": "^4.5.0"
  }
}
